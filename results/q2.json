        "neighbourhood": "$_id.neighbourhood",
        "month": {
          "$literal": "October 2026"
        },
        "total_listings": {
          "$ifNull": [
            {
              "$first": "$listing_count.n"
            },
            0
          ]
        }
      }
    },
    {
      "$sort": {
        "city": 1,
        "neighbourhood": 1
      }
    }
