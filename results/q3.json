{
  "title": "Q3. Bookable availability periods for entire homes in Salem",
  "params": {
    "year": 2026,
    "month": 10,
    "city": "Salem"
  },
  "rows_returned": 333,
  "ms": 89.0,
  "plan": {
    "indexes": [
      "city_nbhd",
      "city_roomtype"
    ],
    "stages": [
      "FETCH",
      "IXSCAN",
      "PROJECTION_SIMPLE"
    ],
    "keys_examined": 3597,
    "docs_examined": 3597,
    "collscan": false
  },
  "pipeline": [
    {
      "$match": {
        "city": "Salem",
        "room_type": "Entire home/apt"
      }
    },
    {
      "$project": {
        "name": 1
      }
    },
    {
      "$lookup": {
        "from": "calendar",
        "localField": "_id",
        "foreignField": "listing_id",
        "pipeline": [
          {
            "$match": {
              "available": true,
              "date": {
                "$gte": "2026-10-01 00:00:00",
                "$lt": "2026-11-01 00:00:00"
              }
            }
          },
          {
            "$project": {
              "_id": 0,
              "date": 1,
              "minimum_nights": 1
            }
          }
        ],
        "as": "night"
      }
    },
    {
      "$unwind": "$night"
    },
    {
      "$setWindowFields": {
        "partitionBy": "$_id",
        "sortBy": {
          "night.date": 1
        },
        "output": {
          "rn": {
            "$documentNumber": {}
          }
        }
      }
    },
    {
      "$addFields": {
        "island": {
          "$subtract": [
            {
              "$floor": {
                "$divide": [
                  {
                    "$toLong": "$night.date"
                  },
                  86400000
                ]
              }
            },
            "$rn"
          ]
        }
      }
    },
    {
      "$setWindowFields": {
        "partitionBy": {
          "l": "$_id",
          "i": "$island"
        },
        "sortBy": {
          "night.date": 1
        },
        "output": {
          "block_end": {
            "$max": "$night.date",
            "window": {
              "documents": [
                "unbounded",
                "unbounded"
              ]
            }
          }
        }
      }
    },
    {
      "$addFields": {
        "nights_left": {
          "$add": [
            {
              "$dateDiff": {
                "startDate": "$night.date",
                "endDate": "$block_end",
                "unit": "day"
              }
            },
            1
          ]
        }
      }
    },
    {
      "$addFields": {
        "can_start": {
          "$gte": [
            "$nights_left",
            {
              "$ifNull": [
                "$night.minimum_nights",
                1
              ]
            }
          ]
        }
      }
    },
    {
      "$group": {
        "_id": {
          "listing_id": "$_id",
          "island": "$island"
        },
        "name": {
          "$first": "$name"
        },
        "start": {
          "$min": "$night.date"
        },
        "end": {
          "$max": "$night.date"
        },
        "nights": {
          "$sum": 1
        },
        "min_nights_at_start": {
          "$top": {
            "sortBy": {
              "night.date": 1
            },
            "output": "$night.minimum_nights"
          }
        },
        "bookable": {
          "$max": "$can_start"
        },
        "first_valid_checkin": {
          "$min": {
            "$cond": [
              "$can_start",
              "$night.date",
              null
            ]
          }
        }
      }
    },
    {
      "$match": {
        "bookable": true
      }
    },
    {
      "$sort": {
        "name": 1,
        "start": 1
      }
    },
    {
      "$project": {
        "_id": 0,
        "listing_id": "$_id.listing_id",
        "name": 1,
        "month": {
          "$literal": "October 2026"
        },
        "start": {
          "$dateToString": {
            "date": "$start",
            "format": "%Y-%m-%d"
          }
        },
        "end": {
          "$dateToString": {
            "date": "$end",
            "format": "%Y-%m-%d"
          }
        },
        "nights": 1,
        "min_nights_at_start": 1,
        "bookable": 1,
        "first_valid_checkin": {
          "$dateToString": {
            "date": "$first_valid_checkin",
            "format": "%Y-%m-%d"
          }
        }
      }
    }
  ],
